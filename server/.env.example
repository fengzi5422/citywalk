# 复制为 .env（本地）或在服务器上直接注入环境变量
PORT=5179
HOST=127.0.0.1

# 数据库文件位置；Docker 部署时由 compose 设为 /data/citywalk.db
# DB_PATH=/data/citywalk.db

# 生产环境必填：openssl rand -hex 32
JWT_SECRET=

# 前端来源白名单，逗号分隔。同源部署（nginx 反代 /api）不触发跨域，可留默认
CORS_ORIGINS=http://127.0.0.1:5178,http://localhost:5178

SHARE_TTL_DAYS=7
MAX_SHARE_BYTES=65536
