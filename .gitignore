# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
dist-ssr/
build/
*.tsbuildinfo

# 环境变量（含密钥，禁止入库）
.env
.env.local
.env.*.local

# 运行时数据
server/data/*.db
server/data/*.db-*
data/
backups/

# 日志与临时文件
*.log
npm-debug.log*
.vite/
.tmp/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 验证截图（可由 docs/*.mjs 重新生成）
app/shots/

# Capacitor / Android 构建产物（android/ 工程本身要入库）
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab
*.keystore
*.jks

# 工位记忆与自动化产物，不入库
.workbuddy/
