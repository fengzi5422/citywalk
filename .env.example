# 复制为 .env 后再执行 scripts/deploy.sh；.env 已被 .gitignore 排除，不会入库。

# ── 后端运行期变量：改完重启 api 容器即生效 ─────────────────

# 必填：生产环境强制要求，用 openssl rand -hex 32 生成（至少 32 字符）
# 仅后端用来签发 JWT；前端与 App 都拿不到，也不要写进任何 VITE_* 变量。
JWT_SECRET=

# 允许跨域访问 /api 的来源，逗号分隔，精确匹配 Origin（不含路径、不带尾部斜杠）
# 纯网页同源部署时浏览器不触发 CORS，可留默认。
# 只要前端含独立域名网页 / 原生 App / Capacitor WebView，就必须把对应 origin 列进来：
#   Android WebView: https://localhost    iOS WebView: capacitor://localhost
# 网页 + App 混合部署示例：
# CORS_ORIGINS=https://citywalk.example.com,https://localhost,capacitor://localhost
CORS_ORIGINS=http://localhost:8080

# ── 前端构建期变量：打进 JS，改了必须重新 build，App 还要重打 APK ──

# 后端 API 地址，不含尾部斜杠。
#   · 纯网页同源部署：留空，请求 /api 由 nginx 反代到 api 容器
#   · 网页 + App 混合：填「网页自己的 https 域名」，如 https://citywalk.example.com
#     网页端仍是同源（不触发 CORS），App 端直连该域名，一份 dist 两端通用
#   · 仅前后端分离部署（前端 CDN + 后端独立域名）才填后端专属域名
# 注意：App 端必须 HTTPS —— Android 默认禁止明文 HTTP 流量，填 http://IP:8080 会连不上。
VITE_API_BASE=

# 可选：天地图「浏览器端」key，白名单校验 Referer 域名（不带协议头）。
# 网页端：把正式域名加入控制台白名单。
# 原生 App 的 WebView 不发送常规 Referer，浏览器端 key 可能返回 403；
# 建议 App 端留空使用离线示意图，或在「我的 → 地图底图」里单独填入实测可用的 key。
VITE_TIANDITU_TK=

# 可选但正式发布必须：天地图官网公示的审图号（形如 GS(2025)xxxx号）。
# 网页与 App 标注的是同一份底图，填同一个编号即可，无需按平台分别申请。
# 未填时地图页会明确提示需标注，不会编造编号。
VITE_TIANDITU_AUDIT_NO=

# 分享链接有效期（天）
SHARE_TTL_DAYS=7
