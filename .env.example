# 复制为 .env 后再执行 scripts/deploy.sh；.env 已被 .gitignore 排除，不会入库。

# 必填：生产环境强制要求，用 openssl rand -hex 32 生成（至少 32 字符）
JWT_SECRET=

# 同源部署（Docker Compose 默认）留空即可，浏览器不触发跨域
# 前后端分离部署时填正式域名，如 https://citywalk.example.com
CORS_ORIGINS=http://localhost:8080

# 前后端分离部署时填后端地址；同源部署留空
VITE_API_BASE=

# 可选：天地图浏览器端 key。生产环境请在控制台把正式域名加入 Referer 白名单。
# 留空则前端默认使用离线示意图底图，功能不受影响。
VITE_TIANDITU_TK=

# 可选：天地图审图号。正式发布前必须申请并填写真实编号；
# 留空时地图页会提示「审图号以天地图官网公示为准」。
VITE_TIANDITU_AUDIT_NO=

# 分享链接有效期（天）
SHARE_TTL_DAYS=7
