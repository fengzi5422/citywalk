# 复制为 .env 后再执行 scripts/deploy.sh；.env 已被 .gitignore 排除，不会入库。

# ── 后端运行期变量：改完重启 api 容器即生效 ─────────────────

# 必填：生产环境强制要求，用 openssl rand -hex 32 生成（至少 32 字符）
# 仅后端用来签发 JWT；前端与 App 都拿不到，也不要写进任何 VITE_* 变量。
JWT_SECRET=

# 允许跨域访问 /api 的来源，逗号分隔，精确匹配 Origin（不含路径、不带尾部斜杠）
# 纯网页同源部署时浏览器不触发 CORS，可留默认。
# 只要前端含独立域名网页 / 原生 App / Capacitor WebView，就必须把对应 origin 列进来：
#   Android WebView: https://localhost    iOS WebView: capacitor://localhost
# 网页 + App 混合部署示例：
# CORS_ORIGINS=https://citywalk.example.com,https://localhost,capacitor://localhost
# 只有公网 IP、无域名时（网页同源，App 跨域）：
# CORS_ORIGINS=http://123.57.92.56:8080,https://localhost,http://localhost,capacitor://localhost
# 若网页端来源无法枚举（前端可能部署在任意位置），可设 CORS_ORIGINS=* 放行所有来源；
# 本项目用 Authorization 头而非 cookie，通配不会泄露凭证，但等于向任意站点开放接口。
CORS_ORIGINS=http://localhost:8080

# ── 前端构建期变量：打进 JS，改了必须重新 build，App 还要重打 APK ──

# 后端 API 地址，不含尾部斜杠。
#   · 纯网页同源部署：留空，请求 /api 由 nginx 反代到 api 容器
#   · 网页 + App 混合：填「网页自己的地址」——有域名填 https 域名，只有 IP 就填 http://IP:8080
#     网页端仍是同源（不触发 CORS），App 端直连该地址，一份 dist 两端通用
#   · 仅前后端分离部署（前端 CDN + 后端独立地址）才填后端专属地址
# 只有公网 IP 时示例：VITE_API_BASE=http://123.57.92.56:8080
# 此时 App 依赖明文放行（见 DEPLOY.md「只有公网 IP、没有域名」），正式公开前建议换 HTTPS。
VITE_API_BASE=

# 可选：天地图「浏览器端」key，白名单校验 Referer 域名（不带协议头）。
# 网页端：把正式域名加入控制台白名单。
# 原生 App 的 WebView 不发送常规 Referer，浏览器端 key 可能返回 403；
# 建议 App 端留空使用离线示意图，或在「我的 → 地图底图」里单独填入实测可用的 key。
VITE_TIANDITU_TK=

# 可选但正式发布必须：天地图官网公示的审图号（形如 GS(2025)xxxx号）。
# 网页与 App 标注的是同一份底图，填同一个编号即可，无需按平台分别申请。
# 未填时地图页会明确提示需标注，不会编造编号。
VITE_TIANDITU_AUDIT_NO=

# 分享链接有效期（天）
SHARE_TTL_DAYS=7

# ── 可选：大陆 ECS 拉不到 Docker Hub 时，用 .env 覆盖基础镜像 ──
# 不设则用官方 node:22-alpine / nginx:alpine。这样只改 .env，不改仓库文件，
# 以后 git pull 不会冲突。取消下面三行注释即可改用镜像代理（以实际可用为准）：
# BASE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# BUILDER_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# RUNTIME_IMAGE=docker.m.daocloud.io/library/nginx:alpine
